# Botkeep Deployment Environment Variables
# Copy these values into your Botkeep server environment variables tab

# App Environment
POSTA_ENV=dev
POSTA_EMBEDDED_WORKER=true
POSTA_PORT=9000

# Security (JWT secret must be at least 32 characters, admin password at least 12 characters)
POSTA_JWT_SECRET=f9a83b27c1e549d08e1a7b3c5d6e2f1048a9c3d2e1f4b5a6c7d8e9f0a1b2c3d4
POSTA_ADMIN_EMAIL=admin@rixoffice.com
POSTA_ADMIN_PASSWORD=AdminPass2026!Secure

# PostgreSQL Database (Fill with connection details from your Botkeep PostgreSQL service)
POSTA_DB_HOST=your-postgres-host.botkeep.cloud
POSTA_DB_PORT=5432
POSTA_DB_NAME=posta
POSTA_DB_USER=posta
POSTA_DB_PASSWORD=your_postgres_password
POSTA_DB_SSL_MODE=disable

# Redis (Fill with connection details from your Botkeep Redis service)
POSTA_REDIS_ADDR=your-redis-host.botkeep.cloud:6379
# POSTA_REDIS_PASSWORD=your_redis_password
